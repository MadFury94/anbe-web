{
  "name": "tejere-anderson-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "client": "npm run dev --prefix client",
    "dev": "npm run client",
    "build": "npm run build --prefix client",
    "typecheck": "node client/node_modules/typescript/bin/tsc -p client/tsconfig.app.json --noEmit",
    "deploy": "npm run build && wrangler pages deploy client/dist --project-name tejere-anderson-services --branch tejere",
    "install:all": "npm ci --prefix client",
    "test:smoke": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
